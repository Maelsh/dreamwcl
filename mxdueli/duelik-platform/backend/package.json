{
  "name": "duelik-backend",
  "version": "1.0.0",
  "description": "Backend API for Dueli Competition Platform - Complete Competition Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:api": "jest --testPathPattern=tests/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "backup": "node scripts/backup-db.js",
    "seed": "node mongodb-setup.js seed",
    "db:setup": "node mongodb-setup.js seed",
    "db:clear": "node mongodb-setup.js clear",
    "db:test": "node mongodb-setup.js connect-test",
    "db:stats": "node mongodb-setup.js stats",
    "mongodb:init": "bash setup-mongodb.sh init",
    "mongodb:test": "bash setup-mongodb.sh test",
    "setup": "./start.sh"
  },
  "keywords": [
    "api",
    "duelik",
    "competition",
    "nodejs",
    "express",
    "mongodb",
    "websocket",
    "socketio",
    "jwt",
    "authentication",
    "real-time",
    "social-platform"
  ],
  "author": "MiniMax Agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minimax/duelik-backend.git"
  },
  "bugs": {
    "url": "https://github.com/minimax/duelik-backend/issues"
  },
  "homepage": "https://github.com/minimax/duelik-backend#readme",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "express-slow-down": "^2.0.4",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "socket.io": "^4.7.4",
    "nodemailer": "^6.9.7",
    "dotenv": "^16.3.1",
    "aws-sdk": "^2.1509.0",
    "redis": "^4.6.12",
    "mime-types": "^2.1.35",
    "validator": "^13.11.0",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.1",
    "node-cron": "^3.0.3",
    "express-fileupload": "^1.4.3",
    "path-to-regexp": "^6.2.1",
    "content-type": "^1.0.5",
    "cookie": "^0.6.0",
    "serve-static": "^1.15.0",
    "http-errors": "^2.0.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "@types/node": "^20.10.5",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "@jest/globals": "^29.7.0",
    "faker": "^6.6.6",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "directories": {
    "test": "tests",
    "doc": "docs"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/logs/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
